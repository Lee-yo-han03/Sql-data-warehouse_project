print("Python 연결 라이브러리 및 계정 설정 완료")
import psycopg2

# PostgreSQL 접속 설정
DB_CONFIG = {
    "user": "postgres",
    "password": "colab_local_only",
    "host": "127.0.0.1",
    "port": 5432
}

# 1. 기본 데이터베이스에 접속
conn = psycopg2.connect(
    dbname="postgres",
    **DB_CONFIG
)
conn.autocommit = True

# 2. Datawarehouse 데이터베이스 생성
with conn.cursor() as cur:
    cur.execute("""
        SELECT 1
        FROM pg_database
        WHERE datname = 'datawarehouse';
    """)

    if cur.fetchone() is None:
        cur.execute("CREATE DATABASE datawarehouse")
        print("Datawarehouse 데이터베이스 생성 완료")
    else:
        print("Datawarehouse 데이터베이스가 이미 존재합니다")

conn.close()

# 3. Datawarehouse 데이터베이스에 접속
conn = psycopg2.connect(
    dbname="datawarehouse",
    **DB_CONFIG
)

# 4. Bronze, Silver, Gold 스키마 생성
with conn.cursor() as cur:
    cur.execute("CREATE SCHEMA IF NOT EXISTS bronze;")
    cur.execute("CREATE SCHEMA IF NOT EXISTS silver;")
    cur.execute("CREATE SCHEMA IF NOT EXISTS gold;")

    # 생성 결과 확인
    cur.execute("""
        SELECT schema_name
        FROM information_schema.schemata
        WHERE schema_name IN ('bronze', 'silver', 'gold')
        ORDER BY schema_name;
    """)

    print("\n생성된 스키마:")
    for row in cur.fetchall():
        print(row[0])

conn.commit()
conn.close()

print("\n데이터 웨어하우스 초기 설정 완료!")
